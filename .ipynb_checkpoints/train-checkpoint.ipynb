   "source": [
    "def twoSum(nums: List[int], target: int) -> List[int]:\n",
    "    lst=[]\n",
    "    for x in nums:\n",
    "        for y in nums:\n",
    "            if (x is y) == True:\n",
    "                continue\n",
    "            elif x+y == target:\n",
    "                lst.append(nums.index(x))   \n",
    "    return lst"
   ]
  }
